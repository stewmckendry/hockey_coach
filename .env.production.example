# Production Environment Variables
# Copy this to .env.production and fill in your values

# Environment
ENVIRONMENT=production

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# ChromaDB Cloud Configuration (same as development - already deployed)
CHROMA_SERVER_HOST=your_chroma_host_here
CHROMA_SERVER_HTTP_PORT=443
CHROMA_TOKEN=your_chroma_token_here

# MCP Server Configuration
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Bridge API Configuration
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=3003
MCP_SERVER_URL=http://hockey-mcp:8000/mcp

# Web App Configuration
HOCKEY_MCP_DIRECT_URL=http://hockey-bridge:3003
WEB_APP_URL=https://your-app.com
ADMIN_URL=https://admin.your-app.com

# Logging
LOG_LEVEL=INFO
