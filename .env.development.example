# Development Environment Variables
# Copy this to .env.development for local development

# Environment
ENVIRONMENT=development

# OpenAI Configuration (required)
OPENAI_API_KEY=your_openai_api_key_here

# ChromaDB Cloud Configuration (required)
CHROMA_SERVER_HOST=your_chroma_host_here
CHROMA_SERVER_HTTP_PORT=443
CHROMA_TOKEN=your_chroma_token_here

# MCP Server Configuration (development uses SSE by default)
MCP_TRANSPORT=sse
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Bridge API Configuration (uses in-memory client in development)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3003

# Web App Configuration
HOCKEY_MCP_DIRECT_URL=http://localhost:3003
NEXT_PUBLIC_FASTMCP_URL=http://localhost:3001

# Logging
LOG_LEVEL=DEBUG
