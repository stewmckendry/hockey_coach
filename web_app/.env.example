# Environment Variables
# Copy this file to .env.local and update values for your environment

# OpenAI Configuration (SECURE - Server-side only)
OPENAI_API_KEY=your_openai_api_key_here

# MCP Server Configuration
MCP_SERVER_URL=http://localhost:8000
NEXT_PUBLIC_FASTMCP_URL=http://localhost:3001

# Development Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Future Authentication (placeholder)
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=http://localhost:3000

# Optional: Production Rate Limiting
# RATE_LIMIT_REDIS_URL=your_redis_url
